# PlatformIO
.pio/

# Compilation database (pio run -t compiledb) — lands in the project root, not .pio/, and
# embeds absolute toolchain paths from whoever built it.
compile_commands.json
.cache/

# Site-specific everything: real IPs, credentials, the remotes' RF addresses, personal
# notes. This repository is destined to be public — see RULE 0 in CLAUDE.md.
local/*
!local/README.md

# Firmware credentials, including the remotes' RF identity. The committed file is
# include/secrets.h.example, which carries placeholders only.
include/secrets.h

# Serial capture
logs/

# Claude Code — machine-local overrides
.claude/settings.local.json

# Private agent context. CLAUDE.md is the public half of the project instructions and is
# bound by RULE 0; CLAUDE.local.md is the private half and carries the infrastructure
# detail RULE 0 keeps out of the tree. Claude Code loads both automatically, so the split
# costs nothing at runtime. This entry is what keeps the private half out of GitHub — do
# not remove it, and never `git add -f` the file.
CLAUDE.local.md

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# macOS
.DS_Store
