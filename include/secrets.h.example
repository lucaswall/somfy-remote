// Copy to include/secrets.h and fill in. secrets.h is gitignored — this repository is
// destined to be public, see RULE 0 in CLAUDE.md. Never commit real values.
//
// The ESP8266 is 2.4 GHz only: WIFI_SSID must be a 2.4 GHz network.

#pragma once

#define WIFI_SSID       "your-2.4GHz-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

#define MQTT_HOST       "192.0.2.10"      // your broker
#define MQTT_PORT       1883
#define MQTT_USER       "your-mqtt-user"  // a login dedicated to this device
#define MQTT_PASSWORD   "your-mqtt-password"

// The root of this bridge's topic tree, and the stem of every Home Assistant unique_id
// and device identifier it publishes. Home Assistant keys entities on those, so changing
// this on a running installation orphans every existing entity — pick it once.
#define MQTT_DEVICE_ID  "wemos_somfy_remote"

// Home Assistant's own discovery prefix, which is separate from the tree above and must
// match the `discovery_prefix` its MQTT integration is configured with. With the wrong
// value the bridge connects and publishes happily while no entity ever appears.
#define HA_DISCOVERY_PREFIX "homeassistant/"

#define OTA_PASSWORD    "your-ota-password"

// The 24-bit address of the first emulated remote; the rest are consecutive, so eight
// remotes starting at 0x100000 occupy 0x100000..0x100007.
//
// These are the RF credentials of real shutters: anyone within radio range who knows them
// can drive the house. They stay out of the repository.
//
// **Write yours down somewhere safe.** A shutter is paired to an address, and losing it
// means walking to every motor and pairing it again. Changing SOMFY_ADDRESS_BASE has the
// same effect as losing it.
#define SOMFY_ADDRESS_BASE 0x000000

// How many remotes to emulate, capped at ROLLING_CODE_MAX_REMOTES. Each one becomes a
// Home Assistant device with a cover, a My switch and a Prog button. Raising this is
// safe; lowering it leaves the extra entities behind in Home Assistant, and their rolling
// codes in EEPROM, until you delete them by hand.
#define SOMFY_REMOTE_COUNT 12
