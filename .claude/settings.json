{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pio run *)",
      "Bash(pio test *)",
      "Bash(pio device list)",
      "Bash(pio pkg *)",
      "Bash(pio system info)",
      "Bash(pio --version)",
      "Bash(make *)",
      "Bash(lsof /dev/cu.*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(gh repo *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(pio device monitor*)",
      "Bash(* -t monitor*)"
    ]
  }
}
